EXPO_PUBLIC_APP_ENV=development
# For a physical phone, replace localhost with the API PC's Wi-Fi IPv4 address.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
# Same project and public key as SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY in vooma-api.
# Never put a secret/service-role key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://rtfnjoswngmvzolvvctm.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Android key: enable Maps SDK for Android and Places API (New).
# Restrict to com.vooma.passenger and the build's signing SHA-1. Rebuild after changes.
GOOGLE_MAPS_ANDROID_API_KEY=
# Optional iOS Google map and route lines in development/store builds. Rebuild after changes.
# Restrict to com.vooma.passenger and enable Maps SDK for iOS. Expo Go uses Apple Maps.
GOOGLE_MAPS_IOS_API_KEY=
# Optional browser map key: Maps JavaScript API, restricted to your web origins.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
